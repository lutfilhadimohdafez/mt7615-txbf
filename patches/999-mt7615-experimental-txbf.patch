index 851b0e48..bc05c313 100644
--- a/mt7615/mcu.h
+++ b/mt7615/mcu.h
@@ -228,6 +228,16 @@ enum {
 	FW_STATE_N9_RDY = 2,
 };
 
+/* vendor BF_ACTION_CATEGORY / BF_SOUNDING_MODE */
+enum {
+	MT_BF_SOUNDING_ON = 1,
+	MT_BF_DATA_PACKET_APPLY = 2,
+	MT_BF_HW_ENABLE_STATUS_UPDATE = 20,
+};
+
+#define MT_BF_SU_PERIODIC_SOUNDING	2
+#define MT_BF_PROCESSING	4
+
 enum {
 	DBDC_TYPE_WMM,
 	DBDC_TYPE_MGMT,
diff --git a/mt7615/mt7615.h b/mt7615/mt7615.h
index fac05d1b..5e7358e3 100644
--- a/mt7615/mt7615.h
+++ b/mt7615/mt7615.h
@@ -283,6 +283,9 @@ struct mt7615_dev {
 
 	u32 muar_mask;
 
+	/* tx status counters: all, explicit BF, implicit BF */
+	u32 txbf_stat[3];
+
 	struct mt76_connac_pm pm;
 	struct mt76_connac_coredump coredump;
 };
@@ -487,6 +490,9 @@ u32 mt7615_rf_rr(struct mt7615_dev *dev, u32 wf, u32 reg);
 int mt7615_rf_wr(struct mt7615_dev *dev, u32 wf, u32 reg, u32 val);
 int mt7615_mcu_set_dbdc(struct mt7615_dev *dev);
 int mt7615_mcu_set_eeprom(struct mt7615_dev *dev);
