+	debugfs_create_u32("txbf_txs_ibf", 0400, dir, &dev->txbf_stat[2]);
 	debugfs_create_file("scs", 0600, dir, dev, &fops_scs);
 	debugfs_create_file("dbdc", 0600, dir, dev, &fops_dbdc);
 	debugfs_create_file("fw_debug", 0600, dir, dev, &fops_fw_debug);
diff --git a/mt7615/eeprom.c b/mt7615/eeprom.c
index d6828e1c..a78b186e 100644
--- a/mt7615/eeprom.c
+++ b/mt7615/eeprom.c
@@ -168,6 +168,8 @@ static void mt7615_eeprom_parse_hw_cap(struct mt7615_dev *dev)
 	dev->chainmask = BIT(tx_mask) - 1;
 	dev->mphy.antenna_mask = dev->chainmask;
 	dev->mphy.chainmask = dev->chainmask;
